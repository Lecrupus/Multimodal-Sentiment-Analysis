# Copy to .env and adjust. Every value is optional.

# Flask
SECRET_KEY=change-me
PORT=8000
LOG_LEVEL=INFO

# Windows consoles default to cp1252 and crash on DeepFace log emoji.
PYTHONIOENCODING=utf-8

# Limits
MAX_UPLOAD_MB=100
VIDEO_MAX_FRAMES=120
VIDEO_MAX_SECONDS=900
AUDIO_MAX_SECONDS=600

# Models
# TEXT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
# FACE_DETECTOR=opencv        # or retinaface / mtcnn / ssd

# Speech-to-text (downloads an extra model on first use)
ENABLE_ASR=0
ASR_MODEL=openai/whisper-tiny

# Fusion weights
WEIGHT_TEXT=1.0
WEIGHT_AUDIO=0.8
WEIGHT_FACE=0.9
NEUTRAL_BAND=0.15
